{
    "name": "joana-bot-monorepo",
    "version": "1.0.0",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "workspaces": [
        "server",
        "restaurant-bot-web"
    ],
    "scripts": {
        "install:all": "npm install",
        "build:web": "npm run build --workspace=restaurant-bot-web",
        "start": "npm start --workspace=server",
        "build": "npm run build:web",
        "deploy": "npm run build && npm start"
    },
    "dependencies": {
        "concurrently": "^8.2.2"
    }
}